# The panel's templates, stylesheet and script are two-space, which is what prettier writes and what
# the rest of the web expects. Python stays four, as black writes it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html}]
indent_size = 2

[*.{md,yaml,yml,toml}]
indent_size = 2
